# Copy to .env and edit. Every value is optional in mock mode; defaults for everything else are in README.md (Configuration).

# IANA time zone used for "today" boundaries. Defaults to the system time zone.
SIDEKICK_TZ=Europe/London

# 1 = canned task steps, no AWS calls. Remove or comment out to use Bedrock.
SIDEKICK_MOCK_AI=1

# Amazon Bedrock (required when SIDEKICK_MOCK_AI is unset).
# AWS_REGION and the model id are not secrets.
# AWS_REGION=us-east-1
# SIDEKICK_BEDROCK_MODEL_ID=

# Bedrock API key. Put the real value only in your shell or your untracked .env,
# never in this example file. `docker compose --profile bedrock` passes it through.
# AWS_BEARER_TOKEN_BEDROCK=
