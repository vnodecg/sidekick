# Copy to .env and edit. Every value is optional in mock mode; see docs/architecture/ARCHITECTURE.md section 6.

# Transport: stdio (default) or http. `npm start` forces http.
STARTER_TRANSPORT=http
PORT=3000
SIDEKICK_HOST=127.0.0.1

# SQLite file (created on first run). Never commit data files.
SIDEKICK_DB_PATH=./data/sidekick.db

# IANA time zone used for "today" boundaries. Defaults to the system time zone.
SIDEKICK_TZ=Europe/London

# 1 = canned task steps, no AWS calls. Remove or comment out to use Bedrock.
SIDEKICK_MOCK_AI=1

# Amazon Bedrock (required when SIDEKICK_MOCK_AI is unset). Credentials come from
# the AWS SDK default chain (env vars, profile, SSO); never put keys in this file.
# AWS_REGION=us-east-1
# SIDEKICK_BEDROCK_MODEL_ID=

# Per-attempt timeout and total budget (including the one retry) for Bedrock calls.
SIDEKICK_AI_TIMEOUT_MS=2500
SIDEKICK_AI_BUDGET_MS=4500

# Comma-separated browser origins allowed to call /mcp, in addition to localhost.
SIDEKICK_ALLOWED_ORIGINS=

# Optional bearer token. Set it before exposing the server beyond loopback.
# SIDEKICK_AUTH_TOKEN=
