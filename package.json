{
  "name": "sidekick",
  "version": "1.0.0",
  "description": "Voice-first ADHD assistant: a self-hosted MCP server",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/helpers/register-ts.mjs --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import ./tests/helpers/register-ts.mjs --test --watch \"tests/**/*.test.ts\"",
    "build": "tsc && node scripts/copy-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node build/index.js",
    "inspect:http": "npm run build && npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
    "dev": "npm run build && node dev",
    "serve:stdio": "npm run build && STARTER_TRANSPORT=stdio node build/index.js",
    "serve:http": "npm run build && STARTER_TRANSPORT=http PORT=3000 node build/index.js",
    "gen:tool": "hygen tool new",
    "gen:prompt": "hygen prompt new",
    "gen:resource": "hygen resource new",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:fix": "knip --fix",
    "hero": "npm run build && node scripts/hero.mjs",
    "start": "npm run build && node --disable-warning=ExperimentalWarning --import ./scripts/http-transport.mjs build/index.js"
  },
  "keywords": [
    "mcp",
    "adhd",
    "voice"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1151.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/express": "^5.0.4",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.46.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "hygen": "^6.2.11",
    "knip": "^5.66.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "bin": {
    "sidekick": "./build/index.js"
  },
  "files": [
    "build"
  ]
}
